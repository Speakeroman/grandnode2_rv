{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "GrandWebAddress": "http://localhost:5000",
  "ReverseProxy": {
    "Routes": {
      "catch-all": {
        "ClusterId": "grand-web",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "grand-web": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}
